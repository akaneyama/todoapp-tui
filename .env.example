# Copy to .env and adjust. Real environment variables override this file.

# Listen address
APP_ADDR=:8080

# go-sql-driver/mysql DSN. parseTime, loc=UTC, time_zone and utf8mb4 are
# forced by the server, no need to add them here.
DB_DSN=todoapp:todoapp@tcp(127.0.0.1:3306)/todoapp

# Run pending migrations on startup
AUTO_MIGRATE=true

# Session lifetime (sliding) and how often it is extended
SESSION_TTL=720h
SESSION_TOUCH_INTERVAL=1h

# Only set true behind a reverse proxy you control (Caddy/nginx)
TRUST_PROXY=false

# Rate limit for /auth/login and /auth/register (per IP and per username)
LOGIN_RATE_PER_MINUTE=5
LOGIN_BURST=5

# Max request body size in bytes
MAX_BODY_BYTES=1048576

# debug | info | warn | error
LOG_LEVEL=info

# Integration tests only (database name must contain "test"):
# TEST_MARIADB_DSN=todoapp:todoapp@tcp(127.0.0.1:3306)/todoapp_test
